Cell[BoxData[{
 RowBox[{
  RowBox[{"pts", " ", "=", " ", 
   RowBox[{"smallBrownData", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"binSizeRA", " ", "=", " ", 
   RowBox[{"360", "/", "36"}]}], ";", 
  RowBox[{"binSizeDec", " ", "=", " ", 
   RowBox[{"180", "/", "36"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RAEdge", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "360", ",", " ", "binSizeRA"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DecEdge", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "90"}], ",", "90", ",", " ", "binSizeDec"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"counts", " ", "=", " ", 
   RowBox[{"BinCounts", "[", 
    RowBox[{"pts", ",", " ", 
     RowBox[{"{", "RAEdge", "}"}], ",", " ", 
     RowBox[{"{", "DecEdge", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CoolColor", "[", " ", "z_", " ", "]"}], " ", ":=", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"z", ",", 
      RowBox[{"1", "-", "z"}], ",", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "code", " ", "above", " ", "is", " ", "taking", " ", "just", 
     " ", "the", " ", "RA", " ", "and", " ", "Dec", " ", "parts", " ", "of", " ",
      "our", " ", "data", " ", "and", " ", "assigning", " ", "it", " ", "to", 
     " ", "points"}], ",", " ", 
    RowBox[{
    "then", " ", "we", " ", "choose", " ", "to", " ", "break", " ", "up", " ",
      "the", " ", "celestial", " ", "sphere", " ", "into", " ", "a", " ", 
     "square", " ", "with", " ", "36", " ", "X", " ", "36", " ", "squares", " ",
      "across", " ", "to", " ", "find", " ", "where", " ", "the", " ", 
     "stars", " ", "are", " ", "most", " ", "prevelant"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "counts", " ", "variable", " ", "uses", " ", "BinCounts", " ", 
    "to", " ", "count", " ", "up", " ", "how", " ", "many", " ", 
    "BrownDwarfs", " ", "appear", " ", "in", " ", "each", " ", "square"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListDensityPlot", "[", 
   RowBox[{"counts", ",", " ", 
    RowBox[{"DataRange", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "360"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "90"}], ",", "90"}], "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"FrameLabel", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<RA\>\"", ",", " ", "\"\<Dec\>\""}], "}"}]}], ",", " ", 
    RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
    RowBox[{"ColorFunction", " ", "->", "\"\<BlueGreenYellow\>\""}], ",", " ", 
    RowBox[{"InterpolationOrder", " ", "->", " ", "0"}]}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "Plot", " ", "shows", " ", "where", " ", "the", " ", "Brown", 
    " ", "Dwarf", " ", "Stars", " ", "are", " ", "concentrated", " ", "with", 
    " ", "the", " ", "dark", " ", "blue", " ", "representing", " ", "low", " ",
