Cell[BoxData[
 RowBox[{
  RowBox[{"binsdata", " ", "=", 
   RowBox[{"BinLists", "[", 
    RowBox[{"pts", ",", " ", 
     RowBox[{"{", "RAEdge", "}"}], ",", " ", 
     RowBox[{"{", "DecEdge", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Using", " ", "the", " ", "pts"}], ",", " ", "RAEdge", ",", " ", 
    RowBox[{
    "and", " ", "DecEdge", " ", "from", " ", "a", " ", "few", " ", "lines", " ",
      "above"}], ",", " ", 
    RowBox[{
    "this", " ", "code", " ", "creates", " ", "a", " ", "list", " ", "of", " ",
      "lists", " ", "in", " ", "which", " ", "each", " ", "sublist", " ", 
     "is", " ", "a", " ", "bin", " ", "of", " ", "data"}], ",", " ", 
    RowBox[{
    "and", " ", "it", " ", "consists", " ", "of", " ", "the", " ", 
     "declinations", " ", "and", " ", "the", " ", "right", " ", "ascensions", 
     " ", "of", " ", "each", " ", "star", " ", "in", " ", "that", " ", 
     RowBox[{"bin", "."}]}]}], "*)"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.985357776921459*^9, 3.9853577984866505`*^9}, {
