Cell[BoxData[{
 RowBox[{
  RowBox[{"binsdata", " ", "=", " ", 
   RowBox[{"BinLists", "[", 
    RowBox[{"pts", ",", " ", 
     RowBox[{"{", "RAEdge", "}"}], ",", " ", 
     RowBox[{"{", "DecEdge", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lookup", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], "}"}], "->", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "&"}], "/@", 
     "smallBrownData"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Append", "[", 
      RowBox[{"#", ",", 
       RowBox[{"lookup", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], "]"}], "&"}], ",",
     "binsdata", ",", 
    RowBox[{"{", "3", "}"}]}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Using", " ", "the", " ", "pts"}], ",", " ", "RAEdge", ",", " ", 
    "DecEdge", ",", " ", 
    RowBox[{"and", " ", "smallBrownData", " ", "from", " ", "above"}], ",", 
    " ", 
    RowBox[{
    "this", " ", "code", " ", "creates", " ", "a", " ", "list", " ", "of", " ",
      "lists", " ", "in", " ", "which", " ", "each", " ", "sublist", " ", 
     "is", " ", "a", " ", "bin", " ", "of", " ", "data"}], ",", " ", 
    RowBox[{
    "and", " ", "it", " ", "consists", " ", "of", " ", "the", " ", 
     "declinations"}], ",", " ", 
    RowBox[{"right", " ", "ascensions"}], ",", " ", 
    RowBox[{
    "and", " ", "names", " ", "of", " ", "each", " ", "star", " ", "in", " ", 
     "that", " ", 
     RowBox[{"bin", "."}]}]}], "*)"}]}], "\[IndentingNewLine]"}], "Input",
