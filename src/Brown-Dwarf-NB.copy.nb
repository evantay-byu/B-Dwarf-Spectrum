   RowBox[{"k", "=", "1"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"raMin", "=", 
       RowBox[{"raEdges", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"raMax", "=", 
       RowBox[{"raEdges", "[", 
        RowBox[{"[", 
         RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"decMin", "=", 
       RowBox[{"decEdges", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"decMax", "=", 
       RowBox[{"decEdges", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"currentChunk", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"smallBrownData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"raMin", "<=", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "<", "raMax"}], "&&", 
           RowBox[{"decMin", "<=", 
            RowBox[{"#", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "<", "decMax"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "currentChunk", "]"}], ">=", "1"}], ",", 
        RowBox[{
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"\"\<UltracoolChunk\>\"", "<>", 
            RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.csv\>\""}], ",", 
           RowBox[{"Prepend", "[", 
            RowBox[{"currentChunk", ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<name\>\"", ",", "\"\<name_simbadable\>\"", 
               ",", "\"\<raj2000\>\"", ",", "\"\<decj2000\>\""}], "}"}]}], 
            "]"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"k", "++"}], ";"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{
        RowBox[{"Length", "[", "decEdges", "]"}], "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{
        RowBox[{"Length", "[", "raEdges", "]"}], "-", "1"}]}], "}"}]}], "]"}],
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "code", " ", "will", " ", "take", " ", "the", " ", 
    "ultracoolsheet", " ", "and", " ", "split", " ", "it", " ", "up", " ", 
    "into", " ", "chunks", " ", "of", " ", "about", " ", "20", " ", "stars", " ",
     "so", " ", "that", " ", "you", " ", "can", " ", "take", " ", "it", " ", 
    "to", " ", "a", " ", "spectrophotometry", " ", "tool", " ", "and", " ", 
    "pull", " ", "data"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9854368736499233`*^9, 3.9854369001438484`*^9}, 
   3.985437116164591*^9, {3.985437226297924*^9, 3.985437270653263*^9}, {
   3.985437306699957*^9, 3.985437344479391*^9}, {3.9854446927911987`*^9, 
   3.985444711521227*^9}},ExpressionUUID->"0c632d93-c223-bb4f-8da3-\
61a5b2f52805"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotspec", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Bd", ",", "Bd2", ",", "BdSpect", ",", "BdSpect2", ",", "x", ",", "y", ",",
       "x2", ",", "y2", ",", "plot1", ",", "plot2"}], "}"}], ",", 
    RowBox[{
     RowBox[{"Bd", "=", 
      RowBox[{
      "Input", "[", "\"\<input JSON Brown Dwarf Spectrum\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Bd2", "=", 
      RowBox[{
      "Input", "[", "\"\<input a second JSON Brown Dwarf Spectrum\>\"", 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"BdSpect", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"Bd", ",", "\"\<RawJSON\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      RowBox[{
       RowBox[{"BdSpect", "[", "\"\<data\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{
       RowBox[{"BdSpect", "[", "\"\<data\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "\"\<y\>\""}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"BdSpect2", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"Bd2", ",", "\"\<RawJSON\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"x2", "=", 
      RowBox[{
       RowBox[{"BdSpect2", "[", "\"\<data\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"y2", "=", 
      RowBox[{
       RowBox[{"BdSpect2", "[", "\"\<data\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "\"\<y\>\""}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"plot1", "=", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
        RowBox[{"Frame", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"True", ",", "False"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"True", ",", "True"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Microjanskys (\[Micro]Jy)\>\"", ",", "None"}], "}"}],
            ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Micrometers (\[Micro]m)\>\"", ",", "None"}], "}"}]}],
           "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", "Blue"}], ",", 
        RowBox[{"ImagePadding", "->", "40"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"plot2", "=", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x2", ",", "y2"}], "}"}], "]"}], ",", 
        RowBox[{"Frame", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"False", ",", "True"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"False", ",", "False"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"FrameTicks", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"None", ",", "Automatic"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"None", ",", "None"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"None", ",", "\"\<Microjanskys (\[Micro]Jy)\>\""}], "}"}],
            ",", 
           RowBox[{"{", 
            RowBox[{"None", ",", "None"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", "Red"}], ",", 
        RowBox[{"Axes", "->", "False"}], ",", 
        RowBox[{"Background", "->", "None"}], ",", 
        RowBox[{"ImagePadding", "->", "40"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Overlay", "[", 
      RowBox[{"{", 
       RowBox[{"plot1", ",", "plot2"}], "}"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9854365753055744`*^9, 3.9854365753055744`*^9}, {
  3.985444500764778*^9, 3.9854445996253643`*^9}, {3.9854446411781635`*^9, 
  3.98544467472139*^9}},ExpressionUUID->"3f5cd18e-dc52-f742-9b83-\
7edad62304e1"],

Cell[BoxData[{
 RowBox[{"plotspec", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "module", " ", "function", " ", "will", " ", "take", " ", "2",
     " ", "json", " ", "files", " ", "containing", " ", "spectrophotometry", " ",
     "data", " ", "and", " ", "overlay", " ", "both", " ", "so", " ", "that", 
    " ", "you", " ", "will", " ", "be", " ", "able", " ", "to", " ", 
    "compare", " ", "them"}], "*)"}]}]}], "Input",
